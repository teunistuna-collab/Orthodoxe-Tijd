{
  "name": "vite-react-ts",
  "private": true,
  "version": "19.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:leesrooster": "node scripts/leesrooster.check.mjs",
    "check:leefvandaag": "esbuild scripts/leefvandaag.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/leefvandaag.check.mjs --log-level=warning && node node_modules/.cache/leefvandaag.check.mjs",
    "check:vastentafel": "esbuild scripts/vastentafel.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/vastentafel.check.mjs --log-level=warning && node node_modules/.cache/vastentafel.check.mjs",
    "check:geboortecyclus": "esbuild scripts/geboortecyclus.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/geboortecyclus.check.mjs --log-level=warning && node node_modules/.cache/geboortecyclus.check.mjs",
    "check:heiligen": "esbuild scripts/heiligen.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/heiligen.check.mjs --log-level=warning && node node_modules/.cache/heiligen.check.mjs",
    "check:psalmen": "esbuild scripts/psalmen.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/psalmen.check.mjs --log-level=warning && node node_modules/.cache/psalmen.check.mjs",
    "check:paascyclus": "esbuild scripts/paascyclus.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/paascyclus.check.mjs --log-level=warning && node node_modules/.cache/paascyclus.check.mjs",
    "check:psalterlezing": "esbuild scripts/psalterlezing.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/psalterlezing.check.mjs --log-level=warning && node node_modules/.cache/psalterlezing.check.mjs",
    "check:herinneringen": "esbuild scripts/herinneringen.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/herinneringen.check.mjs --log-level=warning && node node_modules/.cache/herinneringen.check.mjs",
    "check:zoeken": "esbuild scripts/zoeken.check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/zoeken.check.mjs --log-level=warning && node node_modules/.cache/zoeken.check.mjs",
    "check:pushserver": "esbuild scripts/pushserver.check.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/pushserver.check.mjs --log-level=warning && node node_modules/.cache/pushserver.check.mjs",
    "push:sleutels": "web-push generate-vapid-keys",
    "push:bouw": "esbuild server/pushserver.ts --bundle --platform=node --format=esm --packages=external --outfile=server/dist/pushserver.mjs --log-level=warning",
    "push:start": "node server/dist/pushserver.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@tailwindcss/vite": "^4.2.1",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.35.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
